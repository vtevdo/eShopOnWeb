{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    },
    "logLevel": {
      "Function.RegisterOrder": "Debug",
      "Host.Startup": "Debug",
      "default": "Information"
    }
  }
}